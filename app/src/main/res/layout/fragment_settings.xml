<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/icon_button_bg"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/settings_back"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_app_icon"
                android:background="@drawable/icon_teal_bg"
                android:padding="7dp"
                android:contentDescription="@string/app_icon" />

        </LinearLayout>

        <!-- ── AUDIO ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="@drawable/section_line"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_audio"
                android:textColor="#1D9E75"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

        </LinearLayout>

        <!-- Language -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_language"
                    android:background="@drawable/icon_chip_bg"
                    android:padding="8dp"
                    android:contentDescription="@string/settings_language"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_language"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_desc"
                android:textColor="#8AFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/languageSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"
                android:popupBackground="@drawable/spinner_popup_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="48dp" />

        </LinearLayout>

        <!-- Speech rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_volume"
                    android:background="@drawable/icon_chip_bg"
                    android:padding="8dp"
                    android:contentDescription="@string/settings_speech_rate"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_speech_rate"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speechRateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_speech_rate_value"
                    android:textColor="#1D9E75"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/value_pill_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_speech_rate_desc"
                android:textColor="#8AFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/speechRateSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="10"
                android:progressTint="#1D9E75"
                android:thumbTint="#1D9E75"
                android:layout_marginStart="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="48dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/settings_speech_rate_min"
                    android:textColor="#66FFFFFF" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_speech_rate_max" android:textColor="#66FFFFFF" android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ── DETECTION ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="@drawable/section_line"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_detection"
                android:textColor="#1D9E75"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

        </LinearLayout>

        <!-- Confidence threshold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_target"
                    android:background="@drawable/icon_chip_bg"
                    android:padding="8dp"
                    android:contentDescription="@string/settings_confidence"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_confidence"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/confidenceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_confidence_value"
                    android:textColor="#1D9E75"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/value_pill_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_confidence_desc"
                android:textColor="#8AFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/confidenceSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="80"
                android:progress="20"
                android:progressTint="#1D9E75"
                android:thumbTint="#1D9E75"
                android:layout_marginStart="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="48dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/settings_confidence_min"
                    android:textColor="#66FFFFFF" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_confidence_max" android:textColor="#66FFFFFF" android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Max objects -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_objects"
                    android:background="@drawable/icon_chip_bg"
                    android:padding="8dp"
                    android:contentDescription="@string/settings_max_objects"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_max_objects"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_max_objects_desc"
                android:textColor="#8AFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3"
                android:layout_marginStart="48dp"
                android:id="@+id/maxObjectsGroup">

                <Button
                    android:id="@+id/btnMax1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/settings_max_objects_1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/toggle_bg"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnMax2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/settings_max_objects_2"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/toggle_selected_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnMax3"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/settings_max_objects_3"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/toggle_bg"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="?android:attr/buttonBarButtonStyle" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── BEHAVIOUR ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="@drawable/section_line"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_behaviour"
                android:textColor="#1D9E75"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

        </LinearLayout>

        <!-- Show preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_eye"
                    android:background="@drawable/icon_chip_bg"
                    android:padding="8dp"
                    android:contentDescription="@string/settings_show_preview"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_show_preview"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_show_preview_desc"
                        android:textColor="#8AFFFFFF"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#1D9E75"
                    android:trackTint="#1D9E75" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>